<?xml version="1.0" encoding="utf-8"?>
<!--
  Include-only: foto da mão (files/hand_reference/) não entra.
  Room file is `unhas-de-que-cor.db` (hyphens; must match AppDatabase.FILE_NAME).
  Path órfão no DataStore é tratado em HandReferenceRepositoryImpl.observe().
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="unhas-de-que-cor.db" />
        <include domain="database" path="unhas-de-que-cor.db-shm" />
        <include domain="database" path="unhas-de-que-cor.db-wal" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="unhas-de-que-cor.db" />
        <include domain="database" path="unhas-de-que-cor.db-shm" />
        <include domain="database" path="unhas-de-que-cor.db-wal" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
