<?xml version="1.0" encoding="utf-8"?>
<!--
  Política explícita: histórico, favoritos e preferências locais podem ir no backup.
  Domínios: database (Room) e files/datastore (Preferences DataStore).
-->
<full-backup-content>
    <include domain="database" path="unhas_de_que_cor.db" />
    <include domain="database" path="unhas_de_que_cor.db-shm" />
    <include domain="database" path="unhas_de_que_cor.db-wal" />
    <include domain="file" path="datastore/" />
</full-backup-content>
